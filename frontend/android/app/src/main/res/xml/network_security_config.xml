<?xml version="1.0" encoding="utf-8"?>
<!-- Sleepy talks to a self-hosted server in the home network:
     * plain http:// (e.g. http://192.168.1.50:8000) is allowed,
     * user-installed CA certificates are trusted, so an internal HTTPS
       certificate (e.g. Caddy "tls internal", own CA) works after installing
       the CA on the phone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
