# Sleepy – Konfiguration (wird vom systemd-Dienst aus /etc/sleepy/sleepy.env geladen).
# Alle Variablen beginnen mit SLEEPY_. Nicht gesetzte Werte nutzen die Standardwerte.

# --- Speicherorte -----------------------------------------------------------
SLEEPY_DATA_DIR=/var/lib/sleepy
# Standard: SQLite unter $SLEEPY_DATA_DIR/db/sleepy.db
# Optional PostgreSQL (pip install "psycopg[binary]"):
# SLEEPY_DATABASE_URL=postgresql+psycopg://sleepy:PASSWORT@127.0.0.1:5432/sleepy
# Pfad dieser Datei (wird in Backups mitgesichert):
SLEEPY_CONFIG_FILE=/etc/sleepy/sleepy.env
# SLEEPY_LOG_DIR=/var/lib/sleepy/logs
# SLEEPY_BACKUP_DIR=/var/lib/sleepy/backups
SLEEPY_BACKUP_KEEP=10
SLEEPY_FRONTEND_DIST=/opt/sleepy/app/frontend/dist

# --- Webserver --------------------------------------------------------------
SLEEPY_HOST=0.0.0.0
SLEEPY_PORT=8000
SLEEPY_LOG_LEVEL=INFO

# --- Reverse Proxy / Sicherheit ---------------------------------------------
# IP(s) des Reverse Proxys, deren X-Forwarded-For/-Proto vertraut wird ("*" = alle)
SLEEPY_TRUSTED_PROXIES=127.0.0.1
# Secure-Cookies: auto (bei HTTPS), true (immer – empfohlen hinter HTTPS-Proxy), false
SLEEPY_COOKIE_SECURE=auto
# Zusätzlich erlaubte Origins für schreibende Anfragen (kommasepariert, meist leer)
# SLEEPY_ALLOWED_ORIGINS=https://sleepy.example.lan
SLEEPY_SESSION_IDLE_MINUTES=480
SLEEPY_SESSION_MAX_DAYS=7
SLEEPY_LOGIN_RATE_LIMIT=10
SLEEPY_LOGIN_RATE_WINDOW_MINUTES=15
SLEEPY_ENABLE_API_DOCS=true

# --- Import -----------------------------------------------------------------
SLEEPY_MAX_UPLOAD_MB=8192
SLEEPY_MAX_UNZIPPED_MB=20480
# Optional: Serververzeichnis, in das SD-Karten-Kopien gelegt werden
# SLEEPY_IMPORT_DIR=/var/lib/sleepy/import
# Automatische Prüfung des Verzeichnisses alle N Minuten (0 = nur manuell)
SLEEPY_IMPORT_SCAN_INTERVAL_MINUTES=0
SLEEPY_STAGING_RETENTION_DAYS=7

# --- Analyse ----------------------------------------------------------------
# Leckage-Schwelle in L/min für Markierungen (ResMed-Konvention: 24 L/min)
SLEEPY_LEAK_THRESHOLD=24
